# ---- Supabase (créer le projet en région Europe : Frankfurt ou Paris) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Stripe (mode Test tant que le site n'est pas ouvert) ----
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Calendly (agenda de la naturopathe) ----
# Lien public d'un type d'événement, ex :
# https://calendly.com/healthy-box/bilan-30min
NEXT_PUBLIC_CALENDLY_URL=

# ---- Emails transactionnels (Resend) ----
# Sans ces deux variables, les relances de panier ne partent pas.
RESEND_API_KEY=
EMAIL_EXPEDITEUR=Healthy Box <contact@votre-domaine.fr>

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
